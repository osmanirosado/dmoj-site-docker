#!/bin/bash

cd "$(dirname "$0")" || exit

copy_if_not_exits() {
  local sample_file="$1"
  local real_file="$2"

  if [[ "${real_file: -1}" == "/" ]]; then
        real_file="${real_file%/}"
  fi

  if [ -d "$real_file" ]
  then
    real_file="$real_file/$(basename "$sample_file")"
  fi

  if [ -e "$real_file" ]
  then
    echo "File exists: '$real_file'"
  else
    echo "Copy config file '$sample_file' to '$real_file'"
    cp "$sample_file" "$real_file"
  fi
}

create_if_not_exits() {
  local real_file="$1"

  if [[ "${real_file: -1}" == "/" ]]; then
        real_file="${real_file%/}"
  fi

  if [ -e "$real_file" ]
  then
    echo "File exists: '$real_file'"
  else
    echo "Create file '$real_file'"
    touch "$real_file"
  fi
}

# mariadb
copy_if_not_exits example/mariadb/my.cnf dmoj/mariadb/conf/

# uwsgi
copy_if_not_exits example/uwsgi.ini dmoj/site/

# django
copy_if_not_exits example/local_settings.py dmoj/site/

# web socket event
copy_if_not_exits example/config.js dmoj/site/

# nginx
copy_if_not_exits example/nginx/dmoj.conf dmoj/nginx/

# environment
copy_if_not_exits example/env/db.env dmoj/env/

# secrets
create_if_not_exits dmoj/secrets/db_password.txt
create_if_not_exits dmoj/secrets/db_root_password.txt
create_if_not_exits dmoj/secrets/django_secret_key.txt
